pipeline {
   agent any
   stages {
      stage('build') {
          step{
               echo "Hi... this is build stage"
               } 
             }
      
      stage('test') {
          step{
               echo "Hi... This is stage 2 ... testing stage"}
               }
      
          }

           
      stage('deploy') {
          step(
               echo "Hi.... This is final stage..."
               )
           }
    }

}
 
    
